+  // Execute mixed operations in file order against one initially empty DB.
+  // Match RocksDB's DoDynamicTwitterExecute: key column 1, operation column 5,
+  // 24-digit ASCII keys, fixed-size values, and targets counted as valid ops.
+  void ExecuteTwitterDynamicCSV(ThreadState* thread) {
+    std::vector<std::string> paths;
+    for (const auto& raw : StringSplit(FLAGS_YCSB_data_file, ',')) {
+      if (!trim(raw).empty()) paths.push_back(trim(raw));
+    }
+    if (paths.empty() || static_cast<uint64_t>(num_) < paths.size()) {
+      fprintf(stderr, "twitterexecutedynamic requires CSV files and num >= file count\n");
+      ErrorExit();
+    }
+    const uint64_t total = static_cast<uint64_t>(num_);
+    const uint64_t per_file = total / paths.size();
+    RandomGenerator gen;
+    WriteBatch batch;
+    uint64_t all_reads = 0, all_writes = 0, all_deletes = 0;
+    uint64_t all_found = 0, all_skipped = 0;
+    for (size_t index = 0; index < paths.size(); ++index) {
+      std::ifstream input(paths[index]);
+      if (!input) {
+        fprintf(stderr, "Unable to open workload file: %s\n", paths[index].c_str());
+        ErrorExit();
+      }
+      const uint64_t target = index + 1 == paths.size()
+          ? total - per_file * index : per_file;
+      uint64_t done = 0, reads = 0, writes = 0, deletes = 0;
+      uint64_t found = 0, skipped = 0, line_number = 0;
+      fprintf(stderr, "Loading cluster execute workload [%zu/%zu]: %s target_ops=%" PRIu64 "\n",
+              index + 1, paths.size(), paths[index].c_str(), target);
+      Stats file_stats;
+      file_stats.Start(thread->tid);
+      file_stats.SetEnableIntervalSideEffects(false);
+      file_stats.SetIntervalReportPrefix("[workload " + std::to_string(index + 1) +
+          "/" + std::to_string(paths.size()) + "] ");
+      thread->stats.ResetLastOpTime();
+      auto skip_row = [&](const char* reason) {
+        ++skipped;
+        if (skipped <= 5) {
+          fprintf(stderr, "Skipped %s:%" PRIu64 ": %s\n", paths[index].c_str(), line_number, reason);
+        }
+      };
+      std::string line;
+      while (done < target && std::getline(input, line)) {
+        ++line_number;
+        const auto row = StringSplit(line, ',');
+        if (row.size() != 7) { skip_row("expected seven fields"); continue; }
+        const std::string operation = trim(row[5]);
+        const bool read = operation == "get" || operation == "gets";
+        const bool write = operation == "set" || operation == "add" || operation == "cas";
+        const bool remove = operation == "delete";
+        if (!read && !write && !remove) { skip_row("unsupported operation"); continue; }
+        std::string key = trim(row[1]);
+        if (key.empty() || key.find_first_not_of("0123456789") != std::string::npos) {
+          skip_row("non-numeric key"); continue;
+        }
+        try { key = std::to_string(std::stoull(key)); }
+        catch (const std::exception&) { skip_row("key outside uint64 range"); continue; }
+        key.insert(0, 24 - key.size(), '0');
+        Status status;
+        uint64_t bytes = key.size();
+        OperationType type;
+        if (read) {
+          std::string value;
+          status = db_.db->Get(read_options_, key, &value);
+          if (status.ok()) { ++found; bytes += value.size(); }
+          else if (!status.IsNotFound()) {
+            fprintf(stderr, "Get error at %s:%" PRIu64 ": %s\n", paths[index].c_str(), line_number, status.ToString().c_str());
+            ErrorExit();
+          }
+          ++reads;
+          type = kRead;
+        } else {
+          batch.Clear();
+          if (write) {
+            batch.Put(key, gen.Generate(FLAGS_value_size_));
+            bytes += FLAGS_value_size_;
+            ++writes;
+            type = kWrite;
+          } else {
+            batch.Delete(key);
+            ++deletes;
+            type = kDelete;
+          }
+          status = db_.db->Write(write_options_, &batch);
+          if (!status.ok()) {
+            fprintf(stderr, "Write error at %s:%" PRIu64 ": %s\n", paths[index].c_str(), line_number, status.ToString().c_str());
+            ErrorExit();
+          }
+        }
+        ++done;
+        file_stats.AddBytes(bytes);
+        thread->stats.AddBytes(bytes);
+        file_stats.FinishedOps(nullptr, db_.db, 1, type);
+        thread->stats.FinishedOps(nullptr, db_.db, 1, type);
+      }
+      if (done != target) {
+        fprintf(stderr, "Workload file ended early: %s executed=%" PRIu64 " target=%" PRIu64 " skipped=%" PRIu64 "\n",
+                paths[index].c_str(), done, target, skipped);
+        ErrorExit();
+      }
+      file_stats.Stop();
+      file_stats.AddMessage("file=" + paths[index] + " reads=" + std::to_string(reads) +
+          " writes=" + std::to_string(writes) + " deletes=" + std::to_string(deletes) +
+          " found=" + std::to_string(found) + " skipped=" + std::to_string(skipped));
+      file_stats.Report("twitterexecutedynamic_workload_" + std::to_string(index + 1));
+      fprintf(stderr, "Finished workload [%zu/%zu]: %s ops=%" PRIu64 " reads=%" PRIu64
+                      " writes=%" PRIu64 " deletes=%" PRIu64 " found=%" PRIu64 " skipped=%" PRIu64 "\n",
+              index + 1, paths.size(), paths[index].c_str(), done, reads, writes, deletes, found, skipped);
+      std::string stats;
+      if (db_.db->GetProperty(DB::Properties::kStats, &stats)) {
+        fprintf(stdout, "\n=== Database stats after workload %zu/%zu (cumulative): %s ===\n%s\n",
+                index + 1, paths.size(), paths[index].c_str(), stats.c_str());
+      }
+      fflush(stdout);
+      all_reads += reads; all_writes += writes; all_deletes += deletes;
+      all_found += found; all_skipped += skipped;
+    }
+    thread->stats.AddMessage("(reads:" + std::to_string(all_reads) +
+        " writes:" + std::to_string(all_writes) + " deletes:" + std::to_string(all_deletes) +
+        " total:" + std::to_string(all_reads + all_writes + all_deletes) +
+        " found:" + std::to_string(all_found) + " skipped:" + std::to_string(all_skipped) + ")");
+  }
+
+  void RunCSVWorkload(ThreadState* thread, const std::string& kind) {
+    // These trace-driven experiments use one worker and one operation per batch,
+    // just like the reference shell scripts. Avoid silently replaying per thread.
+    if (FLAGS_threads != 1 || entries_per_batch_ != 1 || FLAGS_value_size_ <= 0) {
+      fprintf(stderr, "CSV workloads require --threads=1 --batch_size=1 and a positive value_size_\n");
+      ErrorExit();
+    }
+    const bool ycsb = kind.size() == 5 && kind.compare(0, 4, "ycsb") == 0 &&
+                      kind[4] >= 'a' && kind[4] <= 'f';
+    const bool point_query = kind == "readcsv";
+    const bool scan_query = kind == "scancsv";
+    const bool query = point_query || scan_query;
+    const bool operation_csv = ycsb || query;
+    const bool cluster = kind == "cluster";
+    std::vector<std::string> paths;
+    for (const auto& path : StringSplit(
+             operation_csv ? FLAGS_YCSB_data_file : FLAGS_data_file_path, ',')) {
+      if (!trim(path).empty()) paths.push_back(trim(path));
+    }
+    if (paths.empty()) {
+      fprintf(stderr, "No CSV workload file specified\n");
+      ErrorExit();
+    }
+    RandomGenerator gen;
+    WriteBatch batch;
+    uint64_t bytes = 0;
+    uint64_t reads = 0;
+    uint64_t found = 0;
+    uint64_t scanned_records = 0;
+    uint64_t nonempty_scans = 0;
+    uint64_t scans = 0, inserts = 0, updates = 0;
+    uint64_t rmws = 0, rmw_found = 0, rmw_writes = 0;
+    const uint64_t total = operation_csv ? FLAGS_ycsb_num : static_cast<uint64_t>(num_);
+    const uint64_t per_file = total / paths.size();
+    for (size_t index = 0; index < paths.size(); ++index) {
+      const auto& path = paths[index];
+      std::ifstream input(path);
+      if (!input) {
+        fprintf(stderr, "Unable to open CSV file: %s\n", path.c_str());
+        ErrorExit();
+      }
+      std::string line;
+      // Zipf/YCSB have a header; the seven-column cluster trace has none.
+      if (!cluster) std::getline(input, line);
+      const uint64_t count = index + 1 == paths.size()
+                                 ? total - per_file * index : per_file;
+      fprintf(stderr, "Loading %s workload [%zu/%zu]: %s (%" PRIu64 " ops)\n",
+              kind.c_str(), index + 1, paths.size(), path.c_str(), count);
+      Stats workload_stats;
+      workload_stats.Start(thread->tid);
+      workload_stats.SetEnableIntervalSideEffects(false);
+      workload_stats.SetIntervalReportPrefix(
+          "[workload " + std::to_string(index + 1) + "/" +
+          std::to_string(paths.size()) + "] ");
+      // Keep per-operation latency free of the preceding dataset's report I/O.
+      thread->stats.ResetLastOpTime();
+      for (uint64_t i = 0; i < count; ++i) {
+        if (!std::getline(input, line)) {
+          fprintf(stderr, "Short CSV file %s: expected %" PRIu64
+                          " records, read %" PRIu64 "\n", path.c_str(), count, i);
+          ErrorExit();
+        }
+        const auto row = StringSplit(line, ',');
+        if (row.size() != (cluster ? 7 : operation_csv ? 2 : 1)) {
+          fprintf(stderr, "Invalid CSV row: %s\n", line.c_str());
+          ErrorExit();
+        }
+        const std::string operation = operation_csv ? trim(row[0]) : "INSERT";
+        bool allowed = !operation_csv;
+        if (point_query || kind == "ycsbc") allowed = operation == "READ";
+        else if (scan_query) allowed = operation == "SCAN";
+        else if (kind == "ycsba" || kind == "ycsbb")
+          allowed = operation == "READ" || operation == "UPDATE";
+        else if (kind == "ycsbd") allowed = operation == "READ" || operation == "INSERT";
+        else if (kind == "ycsbe") allowed = operation == "SCAN" || operation == "INSERT";
+        else if (kind == "ycsbf") allowed = operation == "READ" || operation == "RMW";
+        if (!allowed) {
+          fprintf(stderr, "Unexpected operation for %s: %s\n", kind.c_str(), operation.c_str());
+          ErrorExit();
+        }
+        std::string key = trim(row[cluster || operation_csv ? 1 : 0]);
+        if (key.empty() || key.find_first_not_of("0123456789") != std::string::npos) {
+          fprintf(stderr, "Non-numeric CSV key: %s\n", key.c_str());
+          ErrorExit();
+        }
+        uint64_t numeric_key = 0;
+        try {
+          numeric_key = std::stoull(key);
+        } catch (const std::exception&) {
+          fprintf(stderr, "CSV key outside uint64 range: %s\n", key.c_str());
+          ErrorExit();
+        }
+        if (operation == "SCAN") {
+          if (numeric_key > std::numeric_limits<uint64_t>::max() - FLAGS_csv_scan_key_offset) {
+            fprintf(stderr, "SCAN key offset overflow\n");
+            ErrorExit();
+          }
+          numeric_key += FLAGS_csv_scan_key_offset;
+        }
+        key = std::to_string(numeric_key);
+        if (key.size() < static_cast<size_t>(key_size_)) {
+          key.insert(0, key_size_ - key.size(), '0');
+        }
+        uint64_t operation_bytes = operation_csv ? 0 : key.size() + FLAGS_value_size_;
+        Status status;
+        if (operation == "READ") {
+          std::string value;
+          status = db_.db->Get(read_options_, key, &value);
+          ++reads;
+          if (status.ok()) {
+            ++found;
+            if (operation_csv) operation_bytes = key.size() + value.size();
+          }
+          if (!status.ok() && !status.IsNotFound()) {
+            fprintf(stderr, "Get failed: %s\n", status.ToString().c_str());
+            ErrorExit();
+          }
+          workload_stats.FinishedOps(nullptr, db_.db, 1, kRead);
+          thread->stats.FinishedOps(nullptr, db_.db, 1, kRead);
+        } else if (operation == "SCAN") {
+          ++scans;
+          std::unique_ptr<Iterator> iter(db_.db->NewIterator(read_options_));
+          iter->Seek(key);
+          if (iter->Valid()) ++nonempty_scans;
+          if (iter->Valid() && iter->key().compare(Slice(key)) == 0) ++found;
+          for (int j = 0; j < FLAGS_seek_nexts && iter->Valid(); ++j) {
+            operation_bytes += iter->key().size() + iter->value().size();
+            ++scanned_records;
+            iter->Next();
+          }
+          status = iter->status();
+          iter.reset();
+          if (!status.ok()) {
+            fprintf(stderr, "SCAN failed: %s\n", status.ToString().c_str());
+            ErrorExit();
+          }
+          workload_stats.FinishedOps(nullptr, db_.db, 1, kSeek);
+          thread->stats.FinishedOps(nullptr, db_.db, 1, kSeek);
+        } else if (operation == "RMW") {
+          // Match the existing RocksDB/PebblesDB CSV drivers: write only on hit.
+          ++rmws;
+          std::string value;
+          status = db_.db->Get(read_options_, key, &value);
+          if (!status.ok() && !status.IsNotFound()) {
+            fprintf(stderr, "RMW Get failed: %s\n", status.ToString().c_str());
+            ErrorExit();
+          }
+          if (status.ok()) {
+            ++rmw_found;
+            operation_bytes += key.size() + value.size();
+            batch.Clear();
+            batch.Put(key, gen.Generate(FLAGS_value_size_));
+            status = db_.db->Write(write_options_, &batch);
+            if (!status.ok()) {
+              fprintf(stderr, "RMW Write failed: %s\n", status.ToString().c_str());
+              ErrorExit();
